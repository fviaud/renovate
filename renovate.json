{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "constraints": {
    "npm": "^11"
  },
  "packageRules": [
    {
      "description": "Regrouper les mises à jour mineures et correctives du frontend",
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend (minor/patch)"
    },
    {
      "description": "Node.js : même PR pour l'image Docker et la CI (setup-node). matchDepNames car le packageName de setup-node est actions/node-versions",
      "matchDepNames": ["node"],
      "groupName": "Node.js"
    },
    {
      "description": "@types/node suit la version majeure de Node.js",
      "matchDepNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "Node.js"
    },
    {
      "description": "Node.js : versions paires (LTS) uniquement",
      "matchDepNames": ["node", "@types/node"],
      "allowedVersions": "/^[0-9]*[02468](\\.|$)/"
    },
    {
      "description": "Image Docker Node.js : digest épinglé",
      "matchDatasources": ["docker"],
      "matchDepNames": ["node"],
      "pinDigests": true
    },
    {
      "description": "TypeScript 7 : bloqué tant que typescript-eslint (eslint-config-next) ne le supporte pas",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Garder npm 11 pour les lockfiles : npm 12 échoue (EALLOWREMOTE)",
      "matchManagers": ["renovate-config"],
      "matchPackageNames": ["npm"],
      "enabled": false
    }
  ]
}
